#cloud-config
# Day-0 only. Custom user-data fully replaces the Proxmox-generated cloud-init
# config, so hostname and user creation must be carried here explicitly rather
# than left to the provider's user_account block.
hostname: ${hostname}
fqdn: ${hostname}
preserve_hostname: false

users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}

# Password auth stays off: the config-push path authenticates with the key
# above and escalates through sudo.
ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - qemu-guest-agent
  - haproxy
  # Backend health is read from HAProxy's runtime socket rather than its HTTP
  # stats page, which would mean handling the credentials the config carries.
  # Without a Unix-socket client installed, that read returns nothing and an
  # unreadable load balancer looks like one with no backends.
  - socat
  # LAN split-horizon resolver for jdwlabs.com — see the config this installs,
  # below, and docs/lan-name-resolution.md for why it lives on this VM rather
  # than in-cluster or on the gateway.
  - dnsmasq

# No haproxy.cfg content here on purpose. The distro's placeholder config is
# enough for the service to exist and hold its ports; the real config is
# rendered from live cluster state and pushed through the existing validated
# install path with automatic rollback. A second config-rendering path here
# would drift from the generator that owns it.
#
# dnsmasq is the opposite case: its config is static (one domain override
# plus one forwarder line, terraform/files/dnsmasq-jdwlabs-lan.conf), so
# baking it into cloud-init doesn't create a second rendering path the way
# haproxy.cfg would — there is only ever the one path.
runcmd:
  - systemctl enable --now qemu-guest-agent
  - systemctl enable haproxy
  - systemctl enable --now dnsmasq
  # cloud-init runs write_files before runcmd, so both sysctl drop-ins are
  # already on disk here. Applying them explicitly means the settings hold on
  # first boot rather than only after the next reboot.
  - sysctl --system

# The generated config binds the API frontends on this host's own address, and
# a keepalived VIP peer would later bind an address this instance does not own
# until it wins the election. Setting this now keeps that a config change
# rather than a rebuild.
write_files:
  - path: /etc/sysctl.d/99-haproxy-nonlocal-bind.conf
    content: |
      net.ipv4.ip_nonlocal_bind = 1
  # This VM is the LAN's external UDP ingress hop: nftables DNATs published
  # ports to a NodePort on a *different* host, and forwarding off means the
  # packets are silently dropped rather than refused. The image ships with this
  # at 0, and the Tailscale subnet router on this host needs it for the same
  # reason (scenarios/tailscale-subnet-router.md) — it was previously set only
  # as a side effect of that setup, so a rebuild lost it.
  - path: /etc/sysctl.d/99-ip-forward.conf
    content: |
      net.ipv4.ip_forward = 1
  # Full replace of the package's default /etc/dnsmasq.conf. Cloud-init writes
  # this before packages install and before runcmd enables the service, so
  # dnsmasq starts with the override config already in place, never the
  # distro default. Content is read from one file (see the comment at its
  # top) so this template and the manual deploy runbook can never drift.
  - path: /etc/dnsmasq.conf
    content: |
      ${indent(6, dnsmasq_config)}
