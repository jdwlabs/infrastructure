# Proxmox Connection
proxmox_endpoint         = "https://192.168.1.100:8006/api2/json"
proxmox_api_token_id     = "terraform@pve!token-name"
proxmox_api_token_secret = "your-token-secret"

# Infrastructure
storage_pool = "local-lvm"
talos_iso    = "local:iso/nocloud-amd64.iso"

# Cluster Configuration (used by Go bootstrap tool)
cluster_name           = "cluster"
control_plane_endpoint = "cluster.example.com"
haproxy_ip             = "192.168.1.10"
kubernetes_version     = "v1.37.0"
talos_version          = "v1.14.1"
installer_image        = "ghcr.io/siderolabs/installer:v1.14.1"

haproxy_login_user     = "root"
haproxy_stats_user     = "admin"
haproxy_stats_password = "your-password"

# Restrict the k8s/talos apiserver frontends to these source CIDRs.
# Leave empty ([]) to keep them reachable from anywhere (current default).
admin_allowed_cidrs = []

# Ingress NodePorts (e.g. NGINX Gateway Fabric uses 30180/30543 by default,
# ingress-nginx uses 30080/30443). HAProxy forwards :80/:443 to these ports.
ingress_http_nodeport = 30180
ingress_tls_nodeport  = 30543

proxmox_node_ips = {
  "pve1" = "192.168.1.100"
}

# Control Plane Nodes
talos_control_configuration = [
  {
    node_name = "pve1"
    vm_name   = "talos-cp-1"
    vmid      = 201
    cpu_cores = 4
    memory    = 4096
    disk_size = 50
  },
]

# Worker Nodes
# Sizing guidance:
# - Prefer fewer, larger workers over many small ones: a 4096 MiB worker
#   keeps only ~1-2 GiB schedulable after system reserve, so placement (not
#   total capacity) becomes the binding constraint.
# - Longhorn stores replicas on the worker's own disk: a new worker's
#   disk_size must match or exceed the Longhorn-exposed capacity of any
#   worker it is meant to replace, or replica rebuilds will not fit.
# - On hosts shared with non-Talos VMs (GPU inference, CI runners), keep the
#   sum of all dedicated `memory` below host RAM minus the co-tenant
#   reservation — Proxmox dedicated memory is not reclaimed while a VM runs.
talos_worker_configuration = [
  {
    node_name = "pve1"
    vm_name   = "talos-worker-1"
    vmid      = 301
    cpu_cores = 4
    memory    = 8192
    disk_size = 100
  },
  {
    node_name = "pve2"
    vm_name   = "talos-worker-2"
    vmid      = 302
    cpu_cores = 6
    memory    = 16384
    disk_size = 200
  },
]

# GPU inference VM (AI-SRE local tier)
gpu_vm_ssh_public_key = "ssh-ed25519 AAAA... you@host"

# HAProxy load balancer VM(s)
# Leave this list empty to provision nothing.
#
# One entry is a standalone load balancer: its own ip is the endpoint, and it
# equals haproxy_ip above.
# - Place it on a Proxmox host that runs no control-plane VM, so a single host
#   failure cannot take a control-plane node and the load balancer together.
# - Pick a vmid and an ip that are both free. Verify against the live cluster
#   first; a colliding address takes out the API endpoint, not just the VM.
# - Cut over to the production address only after the replacement is verified
#   on a temporary one (see scenarios/haproxy-vm-rebuild.md).
haproxy_vms = []

# haproxy_vms = [
#   {
#     node_name = "pve1"
#     vm_name   = "haproxy-1"
#     vmid      = 110
#     cpu_cores = 2
#     memory    = 1024
#     disk_size = 10
#     ip        = "192.168.1.199/24"
#   },
# ]

# Two or more entries are a keepalived VRRP group. haproxy_ip stays what DNS,
# kubeconfig and talosconfig point at and becomes a virtual address that moves
# to a surviving instance when one is lost; nothing that points at it changes.
# - Each entry sits on a different Proxmox host, none of them a control-plane
#   host, and gets its OWN ip — never haproxy_ip, which validation rejects.
# - The addresses below are placeholders, not allocations. Prove each one free
#   on the day (scenarios/haproxy-keepalived-cutover.md, "Choose the instance
#   addresses") before it goes anywhere near an apply.
# - vrrp_priority only settles who takes the address when nobody holds it.
#   The group does not preempt, so a returning instance stays a backup.
# - Going from one entry to two changes the running instance's address and
#   cloud-init. Follow the cutover runbook; do not apply this edit unscoped.
#
# haproxy_vms = [
#   {
#     node_name     = "pve1"
#     vm_name       = "haproxy-1"
#     vmid          = 110
#     cpu_cores     = 2
#     memory        = 1024
#     disk_size     = 10
#     ip            = "192.168.1.<free-a>/24"
#     vrrp_priority = 150
#   },
#   {
#     node_name     = "pve5"
#     vm_name       = "haproxy-2"
#     vmid          = 113
#     cpu_cores     = 2
#     memory        = 1024
#     disk_size     = 10
#     ip            = "192.168.1.<free-b>/24"
#     vrrp_priority = 100
#   },
# ]
#
# Required with two or more entries. Exactly 8 letters or digits; generate it
# in the vault edit itself (talops secrets edit), never in a shell whose
# history or transcript would keep it:
# haproxy_vrrp_auth_pass = "<8 letters or digits>"
#
# Only if another VRRP group on the LAN already uses router id 51:
# haproxy_vrrp_router_id = 51

haproxy_gateway        = "192.168.1.254"
haproxy_ssh_public_key = "ssh-ed25519 AAAA... you@host"
